{
  "Comment": "State Machine for Approval Mechanism",
  "StartAt": "Notify Email",
  "States": {
    "Notify Email": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke.waitForTaskToken",
      "TimeoutSeconds": 86400,
      "Arguments": {
        "FunctionName": "YOUR_LAMBDA_NOTIFY_ARN",
        "Payload": "{% $merge([$states.input, { \"taskToken\": $states.context.Task.Token }]) %}"
      },
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 1,
          "MaxAttempts": 3,
          "BackoffRate": 2,
          "JitterStrategy": "FULL"
        }
      ],
      "Next": "Choice"
    },
    "Choice": {
      "Type": "Choice",
      "Choices": [
        {
          "Condition": "{% ($states.input.status) = (\"ACCEPT\") %}",
          "Next": "Update Status Accept"
        }
      ],
      "Default": "Update Status Reject"
    },
    "Update Status Reject": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Output": "{% $states.result.Payload %}",
      "Arguments": {
        "FunctionName": "YOUR_LAMBDA_UPDATE_STATUS_ARN",
        "Payload": "{% $states.input %}"
      },
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 1,
          "MaxAttempts": 3,
          "BackoffRate": 2,
          "JitterStrategy": "FULL"
        }
      ],
      "Next": "SNS Publish"
    },
    "SNS Publish": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sns:publish",
      "Arguments": {
        "TopicArn": "YOUR_SNS_TOPIC_ARN",
        "Message": "{% 'Rejected Request with approvalId: ' & $states.input.approvalId %}",
        "MessageAttributes": {
          "Type": { 
            "DataType": "String",
            "StringValue": "REPORT"
          }
        }
      },
      "End": true
    },
    "Update Status Accept": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke", 
      "Output": "{% $states.result.Payload %}",
      "Arguments": {
        "FunctionName": "YOUR_LAMBDA_UPDATE_STATUS_ARN",
        "Payload": "{% $states.input %}"
      },
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 1,
          "MaxAttempts": 3,
          "BackoffRate": 2,
          "JitterStrategy": "FULL"
        }
      ],
      "End": true
    }
  },
  "QueryLanguage": "JSONata"
}